set shell := ["bash", "-cu"]

run-cyd-backlight-test board="1":
    @case "{{board}}" in \
      1|w) target="thumbv6m-none-eabi"; board_features="pico1,arm" ;; \
      2|2w) target="thumbv8m.main-none-eabihf"; board_features="pico2,arm" ;; \
      *) echo "invalid board '{{board}}' (expected one of: 1, 2, w, 2w)" >&2; exit 1 ;; \
    esac; \
    env CARGO_TARGET_DIR=target/rp-no-lto CARGO_PROFILE_RELEASE_LTO=off cargo build -p linkage-blaze-rp --example cyd_backlight_test --target "$target" --release --features "$board_features" --no-default-features; \
    artifact="$(find "target/rp-no-lto/$target/release/examples" -maxdepth 1 -type f -name 'cyd_backlight_test-*' ! -name '*.d' -printf '%T@ %p\n' | sort -nr | head -n1 | cut -d' ' -f2-)"; \
    if [[ -z "$artifact" ]]; then echo "no built artifact found for cyd_backlight_test" >&2; exit 1; fi; \
    probe-rs run --chip="$([[ "$target" == "thumbv6m-none-eabi" ]] && echo RP2040 || echo RP235x)" "$artifact"

