build-cyd-test board="1":
    @case "{{board}}" in \
      1) target="thumbv6m-none-eabi"; board_features="pico1,arm" ;; \
      2|2w) target="thumbv8m.main-none-eabihf"; board_features="pico2,arm" ;; \
      w) target="thumbv6m-none-eabi"; board_features="pico1,arm" ;; \
