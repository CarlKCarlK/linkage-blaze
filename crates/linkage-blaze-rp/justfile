    esac; \
    env CARGO_TARGET_DIR=target/rp-no-lto CARGO_PROFILE_RELEASE_LTO=off cargo build -p linkage-blaze-rp --example cyd_test --target "$target" --release --features "$board_features" --no-default-features

run name board="1":
    @example_name="{{name}}"; \
    example_name="${example_name//-/_}"; \
    feature_name="$example_name"; \
    if [[ "$feature_name" == "skeleton_clock" ]]; then feature_name="skeleton-clock"; fi; \
    case "{{board}}" in \
      1) target="thumbv6m-none-eabi"; board_features="pico1,arm" ;; \
      2) target="thumbv8m.main-none-eabihf"; board_features="pico2,arm" ;; \
      w) target="thumbv6m-none-eabi"; board_features="pico1,arm,wifi" ;; \
      2w) target="thumbv8m.main-none-eabihf"; board_features="pico2,arm,wifi" ;; \
      *) echo "invalid board '{{board}}' (expected one of: 1, 2, w, 2w)" >&2; exit 1 ;; \
    esac; \
    if [[ "$example_name" == "ballet" ]]; then \
      env CARGO_TARGET_DIR=target/rp-no-lto CARGO_PROFILE_RELEASE_LTO=off cargo rustc -p linkage-blaze-rp --example "$example_name" --target "$target" --release --features "$board_features,$feature_name" --no-default-features -- -A long-running-const-eval; \
    else \
      env CARGO_TARGET_DIR=target/rp-no-lto CARGO_PROFILE_RELEASE_LTO=off cargo build -p linkage-blaze-rp --example "$example_name" --target "$target" --release --features "$board_features,$feature_name" --no-default-features; \
    fi; \
    artifact="$(find "target/rp-no-lto/$target/release/examples" -maxdepth 1 -type f -name "$example_name-*" ! -name '*.d' -printf '%T@ %p\n' | sort -nr | head -n1 | cut -d' ' -f2-)"; \
    if [[ -z "$artifact" ]]; then echo "no built artifact found for $example_name" >&2; exit 1; fi; \
    probe-rs run --chip="$([[ "$target" == "thumbv6m-none-eabi" ]] && echo RP2040 || echo RP235x)" "$artifact"

run-bootsel name board="1":
    @example_name="{{name}}"; \
    example_name="${example_name//-/_}"; \
    feature_name="$example_name"; \
    if [[ "$feature_name" == "skeleton_clock" ]]; then feature_name="skeleton-clock"; fi; \
    case "{{board}}" in \
      1) target="thumbv6m-none-eabi"; board_features="pico1,arm" ;; \
      2) target="thumbv8m.main-none-eabihf"; board_features="pico2,arm" ;; \
      w) target="thumbv6m-none-eabi"; board_features="pico1,arm,wifi" ;; \
      2w) target="thumbv8m.main-none-eabihf"; board_features="pico2,arm,wifi" ;; \
      *) echo "invalid board '{{board}}' (expected one of: 1, 2, w, 2w)" >&2; exit 1 ;; \
    esac; \
    if [[ "$example_name" == "ballet" ]]; then \
      env CARGO_TARGET_DIR=target/rp-no-lto CARGO_PROFILE_RELEASE_LTO=off cargo rustc -p linkage-blaze-rp --example "$example_name" --target "$target" --release --features "$board_features,$feature_name" --no-default-features -- -A long-running-const-eval; \
    else \
      env CARGO_TARGET_DIR=target/rp-no-lto CARGO_PROFILE_RELEASE_LTO=off cargo build -p linkage-blaze-rp --example "$example_name" --target "$target" --release --features "$board_features,$feature_name" --no-default-features; \
    fi; \
    artifact="$(find "target/rp-no-lto/$target/release/examples" -maxdepth 1 -type f -name "$example_name-*" ! -name '*.d' -printf '%T@ %p\n' | sort -nr | head -n1 | cut -d' ' -f2-)"; \
    if [[ -z "$artifact" ]]; then echo "no built artifact found for $example_name" >&2; exit 1; fi; \
    picotool load -x "$artifact"

check name board="1":
    @example_name="{{name}}"; \
    example_name="${example_name//-/_}"; \
    feature_name="$example_name"; \
    if [[ "$feature_name" == "skeleton_clock" ]]; then feature_name="skeleton-clock"; fi; \
    case "{{board}}" in \
      1) target="thumbv6m-none-eabi"; board_features="pico1,arm" ;; \
      2) target="thumbv8m.main-none-eabihf"; board_features="pico2,arm" ;; \
      w) target="thumbv6m-none-eabi"; board_features="pico1,arm,wifi" ;; \
      2w) target="thumbv8m.main-none-eabihf"; board_features="pico2,arm,wifi" ;; \
      *) echo "invalid board '{{board}}' (expected one of: 1, 2, w, 2w)" >&2; exit 1 ;; \
    esac; \
    if [[ "$example_name" == "ballet" ]]; then \
      cargo rustc -p linkage-blaze-rp --example "$example_name" --target "$target" --features "$board_features,$feature_name" --no-default-features -- -A long-running-const-eval; \
    else \
      cargo check -p linkage-blaze-rp --example "$example_name" --target "$target" --features "$board_features,$feature_name" --no-default-features; \
    fi

